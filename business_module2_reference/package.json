{
  "name": "medrep-feedback-module2",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3202",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3202",
    "test": "tsx --test tests/*.test.ts",
    "test:live:difficulty": "tsx tests/live-difficulty-causes.ts",
    "typecheck": "tsc --noEmit",
    "test:bridge": "tsx --test tests/module1-integration.test.ts",
    "demo:bridge": "tsx integrations/module1/run-demo.ts && python3 integrations/module1/build-demo-page.py && python3 integrations/module1/audit_bridge.py demo/module1-bridge/results.json",
    "test:three": "tsx --test tests/module3-integration.test.ts tests/module1-integration.test.ts",
    "demo:three": "tsx integrations/three-modules/run.ts && python3 integrations/three-modules/build-demo.py && python3 integrations/three-modules/audit.py"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5"
  }
}
