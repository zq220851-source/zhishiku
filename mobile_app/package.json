{
  "name": "medrep-coach-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "native:init": "node scripts/init-native.mjs",
    "native:sync": "npm run build && npx cap sync",
    "android": "npm run native:sync && npx cap open android",
    "ios": "npm run native:sync && npx cap open ios",
    "test:contract": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
