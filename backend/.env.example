# Copy to .env for local use; NEVER commit .env, credentials, real staff data.
# Docker Compose uses the PostgreSQL values below; change all credentials before any deployment.
POSTGRES_DB=medrep_platform
POSTGRES_USER=medrep_app
POSTGRES_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://medrep_app:CHANGE_ME_TO_LONG_RANDOM_PASSWORD@db:5432/medrep_platform

# Reverse proxy must publish all API requests under this SAME HTTPS origin as Web UI.
APP_PUBLIC_ORIGIN=https://coach.example.com
COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
PLATFORM_TENANT_ID=company-internal
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Phase 2: independent module credentials; keep in server-side secret manager only.
# Generate each key independently with e.g. `python -c 'import secrets; print(secrets.token_urlsafe(48))'`
# Leave empty to disable an unconnected module. NEVER put them in frontend or mobile bundles.
COACH_SERVICE_KEY=
REVIEW_SERVICE_KEY=
DAILY_SERVICE_KEY=

# Phase 4 STAGING HTTPS proxy: must equal the hostname part of APP_PUBLIC_ORIGIN.
# Configure DNS A/AAAA and firewall ports 80,443 before starting the staging overlay.
APP_DOMAIN=coach-staging.example.com

# Phase 6 native webviews and local development; exact origin allowlist, no wildcard.
MOBILE_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,http://localhost:5173

# Optional Phase 7 MODULE1 read-only source bridge; DISABLED by default.
# Only valid if module1 runs in this process network namespace on localhost.
# DO NOT set to a public IP/domain; never expose the legacy cookie APIs directly.
# MEDREP_MODULE1_READONLY_ORIGIN=http://127.0.0.1:8892

# Optional Phase 8 module 3 live industry digest; disabled by default.
# For production set ONLY a separately deployed trusted HTTPS Worker/domain;
# for local testing allow http://127.0.0.1:8787.
# The API never forwards employee token or user profile and always uses mode=live.
# MEDREP_DAILY_READONLY_ORIGIN=https://YOUR-TRUSTED-WORKER.example.com
